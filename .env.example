# SmartCare 360 — Environment variables (copy to .env locally or Render dashboard)
# NEVER commit this file with real secrets.

# === Profile ===
SPRING_PROFILES_ACTIVE=dev
SMARTCARE_APP_URL=http://localhost:8080

# === Admin (PRIVATE — never publish) ===
SMARTCARE_ADMIN_EMAIL=your-private-admin@email.com
SMARTCARE_ADMIN_PASSWORD=choose-a-strong-password-here
SMARTCARE_ADMIN_NAME=System Administrator
SMARTCARE_ADMIN_MOBILE=9999999999

# === Registration OTP email ===
# auto = try Brevo first (HTTPS), then Gmail SMTP — recommended
SMARTCARE_MAIL_PROVIDER=auto

# Gmail SMTP — works on your local machine
SMARTCARE_MAIL_USERNAME=your-email@gmail.com
SMARTCARE_MAIL_PASSWORD=your-gmail-app-password

# Brevo HTTPS API — required for Render FREE tier (Gmail SMTP blocked on port 587)
# Sign up: https://www.brevo.com → API key + verify sender email
# SMARTCARE_BREVO_API_KEY=your-brevo-api-key
# SMARTCARE_BREVO_SENDER_EMAIL=your-verified-sender@email.com
# SMARTCARE_BREVO_SENDER_NAME=SmartCare 360

# === WhatsApp via Twilio (optional) ===
SMARTCARE_WHATSAPP_ENABLED=false
# TWILIO_ACCOUNT_SID=your-twilio-account-sid
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Database connection — supply privately in the host environment. Do not commit values.
# SMARTCARE_DB_URL=
# SMARTCARE_DB_DRIVER=
# SMARTCARE_DB_USERNAME=
# SMARTCARE_DB_PASSWORD=
# SMARTCARE_DB_DIALECT=
