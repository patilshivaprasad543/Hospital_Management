# Paste these into Render Dashboard → smartcare360 → Environment
# Replace placeholder values with your real secrets.

SPRING_PROFILES_ACTIVE=prod
SMARTCARE_APP_URL=https://your-service.onrender.com

SMARTCARE_ADMIN_EMAIL=your-admin@email.com
SMARTCARE_ADMIN_PASSWORD=your-strong-admin-password
SMARTCARE_ADMIN_NAME=System Administrator
SMARTCARE_ADMIN_MOBILE=9999999999

# Registration OTP — Render FREE blocks Gmail SMTP (port 587). Use Brevo:
SMARTCARE_MAIL_PROVIDER=auto
SMARTCARE_BREVO_API_KEY=your-brevo-api-key
SMARTCARE_BREVO_SENDER_EMAIL=your-verified-sender@email.com
SMARTCARE_BREVO_SENDER_NAME=SmartCare 360

# Optional fallback (only works on paid Render plans):
# SMARTCARE_MAIL_USERNAME=your@gmail.com
# SMARTCARE_MAIL_PASSWORD=your-gmail-app-password

SMARTCARE_WHATSAPP_ENABLED=false
